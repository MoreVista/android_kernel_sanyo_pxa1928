/dev/snd/* 0660 system audio
/dev/galcore 0660 root audio
/dev/graphics/fb* 0660 graphics graphics
/dev/graphics/galcore 0666 graphics graphics
/dev/media0 0660 root camera
/dev/uio3   0660 root camera
